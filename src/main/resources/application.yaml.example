spring:
  application:
    name: lms

  datasource:
    url: ${DB_URL}
    username: ${DB_USERNAME}
    password: ${DB_PASSWORD}
    driver-class-name: org.postgresql.Driver

  jpa:
    hibernate:
      ddl-auto: validate
    show-sql: true
    properties:
      hibernate:
        format_sql: true

  flyway:
    enabled: true
    locations: classpath:db/migration
    baseline-on-migrate: true

jwt:
  # 운영 환경에서는 반드시 충분히 긴 임의 문자열을 JWT_SECRET으로 주입하세요.
  secret: ${JWT_SECRET:local-development-secret-key-must-be-at-least-32-bytes}
  expiration-seconds: ${JWT_EXPIRATION_SECONDS:3600}
