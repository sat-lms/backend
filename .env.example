# Spring 프로파일. 미설정 시 docker compose로 띄우는 app 컨테이너는 prod로,
# 컨테이너 밖에서 직접 실행(IDE, ./gradlew bootRun)하면 dev로 동작합니다.
# 로컬에서 컨테이너를 dev 설정으로 띄우고 싶을 때만 dev로 지정하세요.
# SPRING_PROFILES_ACTIVE=dev

# 로컬에서 애플리케이션을 직접(Docker 밖에서) 실행할 때만 사용됩니다.
# docker compose로 app까지 함께 띄울 때는 docker-compose.yml이 이 값 대신
# postgres 서비스명을 가리키는 DB_URL로 자동 재구성해서 넘기므로 수정할 필요 없습니다.
# 주의: docker-compose.yml의 postgres 서비스는 호스트에 포트를 노출하지 않으므로,
# 이 localhost:5432 값은 docker-compose가 아닌 로컬에 직접 설치한 PostgreSQL을
# 사용할 때만 유효합니다.
DB_URL=jdbc:postgresql://localhost:5432/teamdb
DB_NAME=teamdb
DB_USERNAME=본인DB유저명
DB_PASSWORD=본인DB비밀번호

JWT_SECRET=sat-lms-local-test-secret-key-2026-very-long
JWT_EXPIRATION_SECONDS=3600

# S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=your-private-bucket
AWS_S3_PRESIGNED_EXPIRATION_MINUTES=5

# 운영 프로파일에서 허용할 CORS 오리진. 미설정 시 https://satlms.vercel.app 만 허용합니다.
# 여러 개면 콤마로 구분하세요. dev 프로파일은 application-dev.yaml의 목록을 사용합니다.
# CORS_ALLOWED_ORIGINS=https://satlms.vercel.app
